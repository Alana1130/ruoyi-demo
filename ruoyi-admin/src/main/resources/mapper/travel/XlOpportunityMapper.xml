<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.web.mapper.travel.XlOpportunityMapper">
    <resultMap type="com.ruoyi.web.domain.travel.XlOpportunity" id="XlOpportunityResult">
        <id property="id" column="id"/>
        <result property="destinationId" column="destination_id"/>
        <result property="region" column="region"/>
        <result property="type" column="type"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="contactInfo" column="contact_info"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <sql id="selectVo">select id, destination_id, region, type, title, description, contact_info, create_by, create_time, update_by, update_time, remark from xl_opportunity</sql>
    <select id="selectById" resultMap="XlOpportunityResult"><include refid="selectVo"/> where id = #{id}</select>
    <select id="selectList" resultMap="XlOpportunityResult">
        <include refid="selectVo"/>
        <where>
            <if test="destinationId != null">and destination_id = #{destinationId}</if>
            <if test="type != null and type != ''">and type = #{type}</if>
        </where>
        order by create_time desc, id desc
    </select>
    <select id="selectByKeyword" resultMap="XlOpportunityResult">
        <include refid="selectVo"/>
        <where>
            <if test="keyword != null and keyword != ''">
                and (title like concat('%', #{keyword}, '%') or region like concat('%', #{keyword}, '%') or description like concat('%', #{keyword}, '%'))
            </if>
        </where>
        order by create_time desc limit 50
    </select>
</mapper>
