<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.web.mapper.travel.XlRewardItemMapper">
    <resultMap type="com.ruoyi.web.domain.travel.XlRewardItem" id="XlRewardItemResult">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="starsCost" column="stars_cost"/>
        <result property="price" column="price"/>
        <result property="description" column="description"/>
        <result property="image" column="image"/>
        <result property="stock" column="stock"/>
        <result property="allowPurchase" column="allow_purchase"/>
        <result property="partnerName" column="partner_name"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <select id="selectById" resultMap="XlRewardItemResult">select id, name, type, stars_cost, price, description, image, stock, allow_purchase, partner_name, create_by, create_time, update_by, update_time, remark from xl_reward_item where id = #{id}</select>
    <select id="selectList" resultMap="XlRewardItemResult">
        select id, name, type, stars_cost, price, description, image, stock, allow_purchase, partner_name, create_by, create_time, update_by, update_time, remark from xl_reward_item
        <if test="type != null and type != ''">where type = #{type}</if>
        order by stars_cost
    </select>
    <update id="decrStock">update xl_reward_item set stock = stock - 1, update_time = now() where id = #{id} and (stock &lt; 0 or stock > 0)</update>
</mapper>
